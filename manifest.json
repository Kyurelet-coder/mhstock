{
  "id": "https://Kyurelet-coder.github.io/mhstock/",
  "name": "Monster High Stock & Collection Manager",
  "short_name": "MH Stock",
  "description": "Gestão de Stock, Revenda e Coleção Própria Monster High com Calculadora de Amortização",
  "lang": "pt-PT",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#0D0814",
  "theme_color": "#FF007F",
  "categories": [
    "lifestyle",
    "utilities",
    "shopping",
    "finance"
  ],
  "iarc_rating_id": "e84b3e59-4d36-41ae-a3a0-438c903b866a",
  "prefer_related_applications": false,
  "related_applications": [],
  "scope_extensions": [
    {
      "origin": "https://Kyurelet-coder.github.io"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 380
  },
  "note_taking": {
    "new_note_url": "./index.html?action=add"
  },
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "Monster High Stock Data",
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+mhstock",
      "url": "./index.html?doll=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Adicionar Boneca ou Lote",
      "short_name": "Adicionar",
      "description": "Adicionar nova boneca à coleção ou revenda",
      "url": "./index.html?action=add",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Estante Virtual",
      "short_name": "Estante",
      "description": "Ver a estante virtual da coleção própria",
      "url": "./index.html?tab=shelf",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "MH Stock Summary",
      "short_name": "MH Summary",
      "description": "Resumo em tempo real da Coleção Monster High",
      "tag": "mh-stock-widget",
      "template": "widget-template",
      "ms_ac_template": "./widget.json",
      "data": "./widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "screenshot-mobile.png",
          "sizes": "720x1280",
          "type": "image/png"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Ecrã Principal Monster High Stock"
    },
    {
      "src": "screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Visão Geral do Dashboard"
    }
  ]
}
